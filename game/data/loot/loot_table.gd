class_name LootTable
extends Resource
## Таблица весов лута (CR-07, шаг 7): редкость предмета, сила проклятых и шансы выпадения по источникам.

## Веса редкостей: обычный, магический, редкий, легендарный, проклятый (ItemRoller.Rarity).
@export var rarity_weights := PackedFloat32Array([70, 22, 7, 1, 2])
## С глубиной веса магических и выше растут на эту долю за уровень.
@export var magic_find_per_level := 0.15
## Значения характеристик предметов растут на эту долю за уровень глубины.
@export var power_per_level := 0.08
## Предметы копятся (17.10.2026): каждый подобранный навсегда прибавляет свои характеристики, поэтому они — эта
## доля от прежних (небольшой плюс за предмет, чтобы герой не перекачивался с первых находок). 17.10.2026: 0,3 → 0,2.
@export var stack_power := 0.2
## Проклятый предмет: столько аффиксов-бонусов, каждый сильнее обычного во столько раз, и одно проклятие.
@export var cursed_affixes := 3
@export var cursed_power := 1.8
@export var enemy_drop_chance := 0.003
@export var elite_drop_chance := 0.2
## Сундук: предметов и кристаллов опыта.
@export var chest_items := 1
@export var chest_xp_gems := 5

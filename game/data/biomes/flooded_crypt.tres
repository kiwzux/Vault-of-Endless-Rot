hazard_light_radius = 64.0
music = ExtResource("9_music")
battle_music = ExtResource("10_battle")
decor_wall = Array[StringName]([&"decor_sarcophagus", &"decor_broken_column", &"decor_candelabra"])
decor_open = Array[StringName]([&"decor_bone_pile", &"decor_tomb_slab"])

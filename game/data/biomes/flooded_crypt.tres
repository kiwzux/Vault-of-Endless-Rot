extra_shrines = 2

[resource]
script = ExtResource("1_biome")
id = &"flooded_crypt"
order = 1
name_key = "BIOME_FLOODED_CRYPT"
final_lair = false
waves = ExtResource("3_waves")
objects = SubResource("Resource_rules")

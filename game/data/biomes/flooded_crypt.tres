[ext_resource type="AudioStream" path="res://assets/audio/music/flooded_crypt.wav" id="9_music"]
[ext_resource type="AudioStream" path="res://assets/audio/music/flooded_crypt_battle.wav" id="10_battle"]

[sub_resource type="Resource" id="Resource_rules"]
script = ExtResource("2_rules")
shrine_chance = 0.6
mimic_chance = 0.15
extra_challenges = 2
breakables_max = 12
lore_per_level = 3
curse_altar_chance = 0.5
prisoner_chance = 0.5
prisoner_tries = 2

class_name SfxData
extends Resource
## Звук боя (шаг 11.27): варианты и правила, как он звучит (CombatSound). Новый звук — WAV и .tres в
## data/audio/sfx/; событие находит его по id (cast_<стихия> — взмах заклинания стихии, и т. п.).
## Звуки синтезированы кодом (art/gen_sfx.py); любой можно заменить файлом из набора, не трогая код.

@export var id: StringName
## Варианты: каждый раз — случайный из них.
@export var streams: Array[AudioStream] = []
@export var volume_db := 0.0
## Каждый раз высота плывёт на ± эту долю: сотни попаданий не звучат одной нотой.
@export var pitch_jitter := 0.06
## Не чаще раза за столько секунд: из сотни попаданий в секунду звучат единицы.
@export var cooldown := 0.05
## Сколько этого звука звучит одновременно, не больше.
@export var max_voices := 3
## В мире (панорама и затухание с расстоянием до камеры) или «у себя» (рана своего героя, подбор, рёв босса).
@export var positional := true
## Дальше этого от своего героя звук в мире не звучит вовсе, px мира.
@export var max_distance := 520.0

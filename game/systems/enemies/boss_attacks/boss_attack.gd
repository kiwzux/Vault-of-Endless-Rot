class_name BossAttack
extends Resource
## Приём босса (шаг 12): сначала телеграф — область удара на земле, — через windup с удар. Подкласс — рисунок
## удара (кольцо, спираль, веер, дождь взрывов, рывок, волна, призыв, лужи, крест); числа — в .tres
## (data/enemies/boss_attacks/). Новый приём из готовых рисунков — новый .tres и строка в EnemyData.attacks
## босса, без правки кода.
##
## Ресурс общий для всех боссов с этим приёмом: состояние одного применения живёт в BossCast. Выполняется
## только на хосте (BossBrain); удар — снаряды, взрывы, зоны и телеграфы World/Projectiles, поэтому клиенты
## видят его без новой синхронизации.

@export var id: StringName
## Вес при выборе следующего приёма (приём не повторяется два раза подряд, если есть другой).
@export var weight := 1.0
## С какой фазы босса приём доступен: 0 — сразу, 1 — после первого порога здоровья…
@export var min_phase := 0
## Цель дальше этого — приём не начинается; 0 — с любой дистанции.
@export var max_range := 0.0
## Замах, с: столько горит телеграф до удара. Не сокращается с фазами — уклониться должно быть можно всегда.
@export var windup := 0.8
## Передышка после приёма, с; в поздних фазах короче (EnemyData.phase_tempo).
@export var recovery := 1.6
## Босс стоит во время замаха и удара.
@export var root := true
## Урон удара до множителя урона босса (глубина, ХК, кооператив).
@export var damage := 15.0
@export var color := Color(1.0, 0.3, 0.2)
## Количество — снаряды, взрывы, рывки, лужи, подручные (смысл — у подкласса) — и прибавка за каждую фазу.
@export var count := 1
@export var count_per_phase := 0


## Количество в текущей фазе босса.
func amount(cast: BossCast) -> int:
	return maxi(count + count_per_phase * cast.phase, 1)


## Начало замаха: показать, куда придёт удар.
func telegraph(_cast: BossCast) -> void:
	pass


## Конец замаха: удар.
func strike(_cast: BossCast) -> void:
	pass


## После удара, каждый тик физики: true — приём ещё идёт (серия, спираль, рывок).
func tick(_cast: BossCast, _delta: float) -> bool:
	return false

class_name SkillAction
extends Resource
## Базовое действие навыка (шаг 3, R4): что делает навык при срабатывании. Подклассы — снаряд, конус,
## аура, цепь, орбита, удар с неба, зона, луч, рывок, призыв, ловушка. Числа (урон, количество,
## радиусы, длительность) — из SkillStats навыка; свои параметры действия (скорость снаряда, угол
## конуса…) — в подклассе. Новое действие — новый подкласс; новый навык из готовых действий — .tres.
##
## Действие — общий ресурс навыка у всех героев, поэтому состояние между срабатываниями (угол орбиты,
## время луча) хранит SkillRuntime.state. Выполняется только на хосте: урон считает хост, клиентам
## уходят снаряды и следы через World/Projectiles (ФТ-13).


## Имя действия для модификаторов (SkillModifier.requires_actions) и подсказок.
func kind() -> StringName:
	return &""


## Сработать. false — цели нет: навык попробует снова через SkillRuntime.RETRY_DELAY.
func execute(_rt: SkillRuntime) -> bool:
	return false


## Каждый тик физики между срабатываниями: орбита ранит, пока кружит; луч жжёт.
func tick(_rt: SkillRuntime, _delta: float) -> void:
	pass
